# Shared password the team uses to open /admin
ADMIN_PASSWORD=change-me
# Random long string used to sign login cookies
SESSION_SECRET=change-me-to-a-long-random-string
# Port the server listens on
PORT=3000
# Max upload size per file, in megabytes
MAX_UPLOAD_MB=2048
# Google results sheet (shared "Anyone with the link") — can also be set in the portal
RESULTS_SHEET_URL=
# Student photo link with {id} = QLASS ID, e.g. https://portal.qlass.in/photos/{id}.jpg
PHOTO_URL_PATTERN=

# Separate password for the Instagram & Ads tab (pauses/resumes real ad spend) — kept apart from
# ADMIN_PASSWORD so anyone with the upload password can't touch the ad account. Required to use that tab.
META_ADMIN_PASSWORD=

# --- Instagram & ad tracking (meta/ scripts + /admin "Instagram & Ads" tab). See meta/README.md. ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_IG_USER_ID=
META_PAGE_ID=
# Only needed to publish from meta/instagram.js if the page token differs from META_ACCESS_TOKEN
META_PAGE_TOKEN=
# Only needed for meta/ads.js token-exchange and meta/ads.js token
META_APP_ID=
META_APP_SECRET=
# Local hour (24h) after which the server takes the day's Instagram+ads snapshot
META_SNAPSHOT_HOUR=22
META_TIMEZONE=Asia/Kolkata
